<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-salary-calculations" author="Kirill">
        <createTable tableName="salary_calculations">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <!-- ID сотрудника из сервиса 1 -->
            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- Период расчёта -->
            <column name="period_start" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="period_end" type="DATE">
                <constraints nullable="false"/>
            </column>

            <!-- Входные данные -->
            <column name="gross_salary" type="NUMERIC(10, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="bonuses" type="NUMERIC(10, 2)" defaultValue="0"/>
            <column name="deductions" type="NUMERIC(10, 2)" defaultValue="0"/>

            <!-- Результаты расчёта -->
            <column name="tax_rate" type="NUMERIC(5, 2)"/>
            <column name="taxes_amount" type="NUMERIC(10, 2)"/>
            <column name="social_contributions" type="NUMERIC(10, 2)" defaultValue="0"/>
            <column name="net_salary" type="NUMERIC(10, 2)"/>

            <!-- Статус и метаданные -->
            <column name="status" type="VARCHAR(50)" defaultValue="CALCULATED">
                <constraints nullable="false"/>
            </column>
            <column name="calculated_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>