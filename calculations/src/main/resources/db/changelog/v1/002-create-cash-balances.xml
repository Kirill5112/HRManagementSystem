<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-cash-balances" author="Kirill">
        <createTable tableName="cash_balances">
            <column name="id" type="bigserial">
                <constraints primaryKey="true"/>
            </column>
            <column name="date" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="department_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="varchar(3)">
                <constraints nullable="false"/>
            </column>
            <column name="balance" type="numeric(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="cash_balances" indexName="idx_balance_date">
            <column name="date"/>
        </createIndex>
        <createIndex tableName="cash_balances" indexName="idx_balance_depart">
            <column name="department_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
