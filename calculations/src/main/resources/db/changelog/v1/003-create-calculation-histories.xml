<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-calculation-history" author="Kirill">
        <createTable tableName="calculation_history">
            <column name="id" type="bigserial">
                <constraints primaryKey="true"/>
            </column>
            <column name="calculation_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="step_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="step_order" type="INTEGER"/>
            <column name="input_data" type="JSONB"/>
            <column name="output_data" type="JSONB"/>
            <column name="error_message" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="calculation_history"
                baseColumnNames="calculation_id"
                constraintName="fk_calc_hist"
                referencedTableName="salary_calculations"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
        <createIndex tableName="calculation_history" indexName="idx_calc_hist_calc">
            <column name="calculation_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>