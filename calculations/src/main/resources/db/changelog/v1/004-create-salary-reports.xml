<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-salary-reports" author="Kirill">
        <createTable tableName="salary_reports">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <!-- Период отчёта -->
            <column name="period_start" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="period_end" type="DATE">
                <constraints nullable="false"/>
            </column>

            <!-- Отдел (ID из сервиса 1) -->
            <column name="department_id" type="BIGINT"/>

            <!-- Агрегаты -->
            <column name="total_gross_salary" type="NUMERIC(15, 2)"/>
            <column name="total_net_salary" type="NUMERIC(15, 2)"/>
            <column name="total_taxes" type="NUMERIC(15, 2)"/>
            <column name="avg_salary" type="NUMERIC(10, 2)"/>
            <column name="employee_count" type="INTEGER"/>

            <!-- Метаданные -->
            <column name="generated_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Один отчёт на период и отдел -->
        <addUniqueConstraint
                tableName="salary_reports"
                columnNames="period_start, period_end, department_id"
                constraintName="uk_report"/>

        <!-- Индексы для фильтрации по периоду и отделу -->
        <createIndex tableName="salary_reports" indexName="idx_report_period">
            <column name="period_start"/>
            <column name="period_end"/>
        </createIndex>

        <createIndex tableName="salary_reports" indexName="idx_report_dept">
            <column name="department_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>