<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="007-create-employee-position-grade" author="Kirill">
        <createTable tableName="employee_position_grade">
            <column name="id" type="bigserial">
                <constraints primaryKey="true"/>
            </column>
            <column name="employee_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="position_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="grade_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="employee_position_grade" columnNames="employee_id, position_id"/>
        <addForeignKeyConstraint baseTableName="employee_position_grade" baseColumnNames="employee_id" constraintName="fk_epg_employee"
                                 referencedTableName="employees"
                                 referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>