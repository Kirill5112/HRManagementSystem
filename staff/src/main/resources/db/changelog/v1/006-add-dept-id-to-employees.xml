<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="006-add-dept-id-to-employees" author="Kirill">

        <addColumn tableName="employees">
            <column name="dept_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="employees"
                baseColumnNames="dept_id"
                constraintName="fk_emp_dept"
                referencedTableName="departments"
                referencedColumnNames="id"
                onDelete="RESTRICT"
                onUpdate="CASCADE"/>

        <!-- Индекс для быстрых JOIN по dept_id -->
        <createIndex tableName="employees" indexName="idx_employees_dept">
            <column name="dept_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
